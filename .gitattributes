# Generated LAMMPS run artifacts contain trailing whitespace by design.
# Disable whitespace checks for work directories so diff-hygiene gates
# do not fail on raw simulation logs.
data/lammps_validation/**/work/* -whitespace

# Frozen simulation receipts (GPAW logs etc.) inside visualization bundles keep
# original bytes (digests are content identity); whitespace hygiene does not apply.
data/visualization/bundles/**/assets/** -whitespace
