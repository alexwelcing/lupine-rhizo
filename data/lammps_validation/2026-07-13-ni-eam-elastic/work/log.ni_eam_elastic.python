# These formulas define the derivatives w.r.t. strain components
# Constants uses $, variables use v_
variable d1 equal -(v_pxx1-${pxx0})/(v_delta/v_len0)*${cfac}
variable d1 equal -(v_pxx1--7.9611626126565e-11)/(v_delta/v_len0)*${cfac}
variable d1 equal -(v_pxx1--7.9611626126565e-11)/(v_delta/v_len0)*0.0001
variable d2 equal -(v_pyy1-${pyy0})/(v_delta/v_len0)*${cfac}
variable d2 equal -(v_pyy1-2.37270950560979e-11)/(v_delta/v_len0)*${cfac}
variable d2 equal -(v_pyy1-2.37270950560979e-11)/(v_delta/v_len0)*0.0001
variable d3 equal -(v_pzz1-${pzz0})/(v_delta/v_len0)*${cfac}
variable d3 equal -(v_pzz1--3.16874611011048e-11)/(v_delta/v_len0)*${cfac}
variable d3 equal -(v_pzz1--3.16874611011048e-11)/(v_delta/v_len0)*0.0001
variable d4 equal -(v_pyz1-${pyz0})/(v_delta/v_len0)*${cfac}
