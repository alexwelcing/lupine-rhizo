variable C6pos equal ${d6}
variable C6pos equal 5.4068356829378e-09

# Combine positive and negative

variable C1${dir} equal 0.5*(${C1neg}+${C1pos})
variable C15 equal 0.5*(${C1neg}+${C1pos})
variable C15 equal 0.5*(0.000242417463687667+${C1pos})
variable C15 equal 0.5*(0.000242417463687667+-0.000242419218260677)
