FROM python:3.11-slim

ARG BACKEND=chgnet
ENV PYTHONUNBUFFERED=1
ENV MLIP_BACKEND=${BACKEND}
WORKDIR /app

# GPAW 26.7 is distributed as a source archive.  Compile against system
# OpenBLAS/libxc, then retain the runtime libraries for the isolated CPU job.
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc g++ libopenblas-dev libxc-dev \
    && rm -rf /var/lib/apt/lists/*
ENV CC=g++ CXX=g++

COPY gcp/mlip-cell-runner/requirements-common.txt ./
COPY gcp/mlip-cell-runner/requirements-${BACKEND}.txt ./requirements-backend.txt
RUN python3 -m pip install --no-cache-dir --upgrade pip \
    && python3 -m pip install --no-cache-dir -r requirements-backend.txt \
    && python3 -m pip install --no-cache-dir gpaw==26.7.0

COPY gcp/mlip-cell-runner/mlip_cell_runner.py ./
COPY gcp/mlip-cell-runner/z1_barrier.py ./
COPY gcp/mlip-cell-runner/z1_sparse_dft.py ./
COPY gcp/mlip-cell-runner/z2_soc_tc.py ./
COPY gcp/mlip-cell-runner/z2_soc_tc_contract.py ./
COPY python/lupine_distill ./lupine_distill
COPY python/lupine_distill_runtime ./lupine_distill_runtime
COPY campaigns/v1/z2.campaign-manifest.v1.json ./campaigns/v1/z2.campaign-manifest.v1.json
COPY data/candidates/z2_soc_tc_panel.lock.json ./data/candidates/z2_soc_tc_panel.lock.json

RUN python3 -c "import gpaw; from gpaw.spinorbit import soc_eigenstates" \
    && python3 /app/mlip_cell_runner.py --help >/dev/null

RUN useradd -m -u 1000 mlip
RUN chmod -R a+rX /app
USER mlip
ENTRYPOINT ["python3", "/app/mlip_cell_runner.py"]
CMD ["--help"]
