{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lupine.science/schemas/evidence-bundle.v1.schema.json",
  "title": "EvidenceBundle v1",
  "description": "An immutable receipt for an epistemic claim and its exact scope. A bundle is never edited after publication; a replacement names the prior bundle in supersedes. bundle_id is both the external reference used by ClaimContract bundle_references and the sha256:<lowercase hex> content address computed over the RFC 8785-compatible canonical JSON object with bundle_id omitted (UTF-8, object keys sorted, no insignificant whitespace).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "bundle_id",
    "claim_predicate",
    "epistemic_status",
    "scope",
    "evidence_refs",
    "provenance",
    "supersedes"
  ],
  "properties": {
    "bundle_id": {
      "$ref": "#/$defs/contentHash",
      "description": "Content address of this bundle's canonical payload with bundle_id omitted; ClaimContract premises reference this value directly."
    },
    "claim_predicate": {
      "type": "string",
      "minLength": 1,
      "description": "Stable, machine-readable predicate evaluated by the cited evidence."
    },
    "epistemic_status": {
      "type": "string",
      "enum": [
        "confirmatory",
        "exploratory",
        "descriptive",
        "negative",
        "unsupported"
      ]
    },
    "scope": {
      "$ref": "#/$defs/scope"
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/evidenceRef"
      }
    },
    "provenance": {
      "$ref": "#/$defs/provenance"
    },
    "measurements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/barrierErrorMeasurement"
          },
          {
            "$ref": "#/$defs/signSkewFractionMeasurement"
          },
          {
            "$ref": "#/$defs/medianSignedErrorMeasurement"
          },
          {
            "$ref": "#/$defs/z2RankMeasurement"
          },
          {
            "$ref": "#/$defs/z2EasyAxisMeasurement"
          },
          {
            "$ref": "#/$defs/z2TcMaeMeasurement"
          },
          {
            "$ref": "#/$defs/z2TcCoverageMeasurement"
          }
        ]
      }
    },
    "supersedes": {
      "type": "array",
      "description": "Bundle IDs replaced by this receipt. Empty for an original receipt.",
      "items": {
        "$ref": "#/$defs/contentHash"
      },
      "uniqueItems": true
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "claim_predicate": {
            "const": "barrier_mae_mev<=40"
          }
        },
        "required": [
          "claim_predicate"
        ]
      },
      "then": {
        "required": [
          "measurements"
        ],
        "properties": {
          "measurements": {
            "items": {
              "$ref": "#/$defs/barrierErrorMeasurement"
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "claim_predicate": {
            "const": "signed_error_positive_fraction>0.5"
          }
        },
        "required": [
          "claim_predicate"
        ]
      },
      "then": {
        "required": [
          "measurements"
        ],
        "properties": {
          "measurements": {
            "items": {
              "oneOf": [
                {
                  "$ref": "#/$defs/signSkewFractionMeasurement"
                },
                {
                  "$ref": "#/$defs/medianSignedErrorMeasurement"
                }
              ]
            },
            "allOf": [
              {
                "contains": {
                  "$ref": "#/$defs/signSkewFractionMeasurement"
                },
                "description": "The complete frozen acceptance suite is required: the majority fraction plus both median-band bounds, so an omitted failing bound cannot promote the claim."
              },
              {
                "contains": {
                  "type": "object",
                  "properties": {
                    "metric": {
                      "const": "median_signed_error"
                    },
                    "acceptance_test": {
                      "properties": {
                        "comparator": {
                          "const": "greater_than_or_equal"
                        }
                      },
                      "required": [
                        "comparator"
                      ]
                    }
                  },
                  "required": [
                    "metric",
                    "acceptance_test"
                  ]
                }
              },
              {
                "contains": {
                  "type": "object",
                  "properties": {
                    "metric": {
                      "const": "median_signed_error"
                    },
                    "acceptance_test": {
                      "properties": {
                        "comparator": {
                          "const": "less_than_or_equal"
                        }
                      },
                      "required": [
                        "comparator"
                      ]
                    }
                  },
                  "required": [
                    "metric",
                    "acceptance_test"
                  ]
                }
              }
            ]
          },
          "evidence_refs": {
            "items": {
              "required": [
                "dataset_fingerprint"
              ]
            },
            "description": "Sign-skew receipts must carry the analyzed dataset fingerprint so readiness grading can count distinct datasets rather than campaign names."
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "claim_predicate": {
            "const": "magnetocrystalline_anisotropy_rank_correlation==1"
          }
        },
        "required": ["claim_predicate"]
      },
      "then": {
        "required": ["measurements"],
        "properties": {
          "measurements": {
            "minItems": 4,
            "maxItems": 4,
            "items": {
              "oneOf": [
                {"$ref": "#/$defs/z2RankMeasurement"},
                {"$ref": "#/$defs/z2EasyAxisMeasurement"},
                {"$ref": "#/$defs/z2TcMaeMeasurement"},
                {"$ref": "#/$defs/z2TcCoverageMeasurement"}
              ]
            },
            "allOf": [
              {"contains": {"$ref": "#/$defs/z2RankMeasurement"}},
              {"contains": {"$ref": "#/$defs/z2EasyAxisMeasurement"}},
              {"contains": {"$ref": "#/$defs/z2TcMaeMeasurement"}},
              {"contains": {"$ref": "#/$defs/z2TcCoverageMeasurement"}}
            ]
          }
        }
      }
    },
    {
      "not": {
        "properties": {
          "claim_predicate": {
            "pattern": "^signed_error_positive_fraction>(?!0\\.5$)",
            "description": "Only the single frozen sign-skew predicate is admissible; other thresholds would desynchronize the typed measurement from its bound predicate."
          }
        },
        "required": [
          "claim_predicate"
        ]
      }
    }
  ],
  "$defs": {
    "contentHash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "nonEmptyUniqueStrings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "conditionValue": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "array",
          "minItems": 1,
          "items": {
            "oneOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "number"
              },
              {
                "type": "boolean"
              }
            ]
          }
        }
      ]
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "structures",
        "chemistries",
        "properties",
        "conditions"
      ],
      "properties": {
        "structures": {
          "$ref": "#/$defs/nonEmptyUniqueStrings"
        },
        "chemistries": {
          "$ref": "#/$defs/nonEmptyUniqueStrings"
        },
        "properties": {
          "$ref": "#/$defs/nonEmptyUniqueStrings"
        },
        "conditions": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "$ref": "#/$defs/conditionValue"
          }
        }
      }
    },
    "evidenceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "campaign",
        "campaign_manifest",
        "campaign_manifest_hash",
        "run_id",
        "artifact",
        "artifact_hash",
        "thresholds_version"
      ],
      "properties": {
        "campaign": {
          "type": "string",
          "minLength": 1,
          "description": "Stable campaign identifier."
        },
        "campaign_manifest": {
          "type": "string",
          "minLength": 1,
          "description": "Repository-relative path of the immutable campaign manifest."
        },
        "campaign_manifest_hash": {
          "$ref": "#/$defs/contentHash",
          "description": "SHA-256 of the campaign manifest bytes."
        },
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "artifact": {
          "type": "string",
          "minLength": 1,
          "description": "Repository-relative path of the cited artifact."
        },
        "artifact_hash": {
          "$ref": "#/$defs/contentHash"
        },
        "thresholds_version": {
          "type": "string",
          "minLength": 1
        },
        "dataset_fingerprint": {
          "$ref": "#/$defs/contentHash",
          "description": "Content fingerprint of the analyzed dataset observations; two campaigns sharing a fingerprint are not independent replication."
        }
      }
    },
    "barrierErrorMeasurement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "metric",
        "value",
        "unit",
        "acceptance_test",
        "sample_count"
      ],
      "properties": {
        "metric": {
          "const": "barrier_mae"
        },
        "value": {
          "type": "number",
          "minimum": 0
        },
        "unit": {
          "const": "meV"
        },
        "acceptance_test": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "comparator",
            "threshold",
            "outcome"
          ],
          "properties": {
            "comparator": {
              "const": "less_than_or_equal"
            },
            "threshold": {
              "type": "number",
              "minimum": 0
            },
            "outcome": {
              "enum": [
                "pass",
                "fail"
              ]
            }
          }
        },
        "sample_count": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "signSkewFractionMeasurement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "metric",
        "value",
        "unit",
        "acceptance_test",
        "sample_count"
      ],
      "properties": {
        "metric": {
          "const": "signed_error_positive"
        },
        "value": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "unit": {
          "const": "fraction"
        },
        "acceptance_test": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "comparator",
            "threshold",
            "outcome"
          ],
          "properties": {
            "comparator": {
              "const": "greater_than"
            },
            "threshold": {
              "const": 0.5
            },
            "outcome": {
              "enum": [
                "pass",
                "fail"
              ]
            }
          }
        },
        "sample_count": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "z2Acceptance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["comparator", "threshold", "outcome"],
      "properties": {
        "comparator": {"const": "equal"},
        "threshold": {"type": "number"},
        "outcome": {"enum": ["pass", "fail"]}
      }
    },
    "z2RankMeasurement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["metric", "value", "unit", "acceptance_test", "sample_count"],
      "properties": {
        "metric": {"const": "magnetocrystalline_anisotropy_rank_correlation"},
        "value": {"type": "number", "minimum": -1, "maximum": 1},
        "unit": {"const": "spearman_rho"},
        "acceptance_test": {
          "allOf": [
            {"$ref": "#/$defs/z2Acceptance"},
            {"properties": {"threshold": {"const": 1}}}
          ]
        },
        "sample_count": {"const": 7}
      }
    },
    "z2EasyAxisMeasurement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["metric", "value", "unit", "acceptance_test", "sample_count"],
      "properties": {
        "metric": {"const": "easy_axis_sign_errors"},
        "value": {"type": "integer", "minimum": 0, "maximum": 7},
        "unit": {"const": "materials"},
        "acceptance_test": {
          "allOf": [
            {"$ref": "#/$defs/z2Acceptance"},
            {"properties": {"threshold": {"const": 0}}}
          ]
        },
        "sample_count": {"const": 7}
      }
    },
    "z2TcMaeMeasurement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["metric", "value", "unit", "sample_count"],
      "properties": {
        "metric": {"const": "tc_rnsw_mae_k"},
        "value": {"type": "number", "minimum": 0},
        "unit": {"const": "K"},
        "sample_count": {"const": 7}
      }
    },
    "z2TcCoverageMeasurement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["metric", "value", "unit", "sample_count"],
      "properties": {
        "metric": {"const": "tc_envelope_coverage"},
        "value": {"type": "number", "minimum": 0, "maximum": 1},
        "unit": {"const": "fraction"},
        "sample_count": {"const": 7}
      }
    },
    "medianSignedErrorMeasurement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "metric",
        "value",
        "unit",
        "acceptance_test",
        "sample_count"
      ],
      "properties": {
        "metric": {
          "const": "median_signed_error"
        },
        "value": {
          "type": "number"
        },
        "unit": {
          "const": "meV"
        },
        "acceptance_test": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "comparator",
            "threshold",
            "outcome"
          ],
          "properties": {
            "comparator": {
              "enum": [
                "greater_than_or_equal",
                "less_than_or_equal"
              ]
            },
            "threshold": {
              "type": "number"
            },
            "outcome": {
              "enum": [
                "pass",
                "fail"
              ]
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "comparator": {
                    "const": "greater_than_or_equal"
                  }
                },
                "required": [
                  "comparator"
                ]
              },
              "then": {
                "properties": {
                  "threshold": {
                    "const": 400
                  }
                },
                "required": [
                  "threshold"
                ]
              }
            },
            {
              "if": {
                "properties": {
                  "comparator": {
                    "const": "less_than_or_equal"
                  }
                },
                "required": [
                  "comparator"
                ]
              },
              "then": {
                "properties": {
                  "threshold": {
                    "const": 600
                  }
                },
                "required": [
                  "threshold"
                ]
              }
            }
          ],
          "description": "Thresholds are the frozen T1 median band (400/600 meV) mirrored from tools/lit_to_manifest.py T1_MEDIAN_BAND_MEV; arbitrary per-receipt bounds are not representable."
        },
        "sample_count": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "agent",
        "human",
        "timestamp",
        "preregistration_id"
      ],
      "properties": {
        "agent": {
          "type": "string",
          "minLength": 1,
          "description": "Agent, executable, or workflow that emitted the receipt."
        },
        "human": {
          "type": "string",
          "minLength": 1,
          "description": "Accountable human author or reviewer."
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "preregistration_id": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
