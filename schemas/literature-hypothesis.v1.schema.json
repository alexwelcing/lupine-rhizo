{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lupine.dev/schemas/literature-hypothesis.v1.schema.json",
  "title": "LiteratureHypothesis v1",
  "description": "A literature-derived hypothesis bound to the proved ontology and the existing barrier measurement contract.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "source",
    "claim_text",
    "bindings",
    "epistemicMarker",
    "readiness",
    "confidence",
    "proposedExperiment",
    "status"
  ],
  "properties": {
    "source": {
      "$ref": "#/$defs/source"
    },
    "claim_text": {
      "$ref": "#/$defs/non_empty_string"
    },
    "bindings": {
      "$ref": "#/$defs/bindings"
    },
    "epistemicMarker": {
      "enum": [
        "OBS",
        "INF",
        "TRN",
        "PRP",
        "FRC"
      ]
    },
    "readiness": {
      "type": "string",
      "description": "Ontology readiness grade, optionally followed by a parenthesized annotation.",
      "pattern": "^(H|M|L)( \\([^()]*[^()\\s][^()]*\\))?$(?![\\s\\S])"
    },
    "confidence": {
      "enum": [
        "High",
        "Medium"
      ]
    },
    "proposedExperiment": {
      "$ref": "#/$defs/proposed_experiment"
    },
    "status": {
      "enum": [
        "proposed",
        "accepted",
        "rejected",
        "superseded"
      ]
    }
  },
  "$defs": {
    "non_empty_string": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "nullable_external_id": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "pattern": "\\S"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "arxiv_id",
        "openalex_id",
        "ss_id",
        "doi",
        "url",
        "asOf"
      ],
      "properties": {
        "arxiv_id": {
          "$ref": "#/$defs/nullable_external_id"
        },
        "openalex_id": {
          "$ref": "#/$defs/nullable_external_id"
        },
        "ss_id": {
          "$ref": "#/$defs/nullable_external_id"
        },
        "doi": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^10\\.[0-9]{4,9}/\\S+$"
        },
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "asOf": {
          "type": "string",
          "format": "date"
        }
      },
      "anyOf": [
        {
          "properties": {
            "arxiv_id": {
              "type": "string"
            }
          }
        },
        {
          "properties": {
            "openalex_id": {
              "type": "string"
            }
          }
        },
        {
          "properties": {
            "ss_id": {
              "type": "string"
            }
          }
        },
        {
          "properties": {
            "doi": {
              "type": "string"
            }
          }
        }
      ]
    },
    "bindings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "errorTypes",
        "materialClasses",
        "chains",
        "acceptanceTests"
      ],
      "properties": {
        "errorTypes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^T[1-7]$"
          }
        },
        "materialClasses": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^MC[1-9]$"
          }
        },
        "chains": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^C([1-9]|1[01])$"
          }
        },
        "acceptanceTests": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^Z([1-9]|1[01])$"
          }
        }
      }
    },
    "proposed_experiment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "metric",
        "predicate",
        "estimated_cells",
        "estimated_gpu_hours"
      ],
      "properties": {
        "metric": {
          "enum": [
            "barrier_mae",
            "signed_error_positive"
          ]
        },
        "predicate": {
          "description": "Existing typed-measurement whitelist; each admission requires a typed EvidenceBundle measurement and a D1 migration.",
          "enum": [
            "barrier_mae_mev<=40",
            "signed_error_positive_fraction>0.5"
          ]
        },
        "panel_ref": {
          "$ref": "#/$defs/non_empty_string"
        },
        "estimated_cells": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        },
        "estimated_gpu_hours": {
          "type": "number",
          "minimum": 0
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "predicate": {
                "const": "barrier_mae_mev<=40"
              }
            },
            "required": [
              "predicate"
            ]
          },
          "then": {
            "properties": {
              "metric": {
                "const": "barrier_mae"
              }
            },
            "required": [
              "metric"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "predicate": {
                "const": "signed_error_positive_fraction>0.5"
              }
            },
            "required": [
              "predicate"
            ]
          },
          "then": {
            "properties": {
              "metric": {
                "const": "signed_error_positive"
              }
            },
            "required": [
              "metric"
            ]
          }
        }
      ]
    }
  }
}
