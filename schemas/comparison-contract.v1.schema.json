{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lupine.dev/schemas/comparison-contract.v1.schema.json",
  "title": "Private proposed comparison contract v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "visibility",
    "authorization",
    "runId",
    "proposalId",
    "discoveryPacketSha256",
    "intent",
    "executionKind",
    "findings",
    "evaluation",
    "arms",
    "unknowns",
    "excludedScope",
    "decisionRule",
    "falsifier",
    "stoppingRule"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,95}$"
    },
    "visibility": {
      "const": "private"
    },
    "authorization": {
      "const": "proposed"
    },
    "runId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,95}$"
    },
    "proposalId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,95}$"
    },
    "discoveryPacketSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "intent": {
      "enum": [
        "confirmatory",
        "exploratory",
        "descriptive",
        "methodological"
      ]
    },
    "executionKind": {
      "enum": [
        "source_audit",
        "exact_arithmetic",
        "simulation"
      ]
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sourceId",
          "sourceSha256",
          "anchor",
          "rowIds"
        ],
        "properties": {
          "sourceId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000,
            "pattern": "\\S"
          },
          "sourceSha256": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "anchor": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000,
            "pattern": "\\S"
          },
          "rowIds": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,95}$"
            },
            "minItems": 0,
            "maxItems": 24
          }
        }
      },
      "minItems": 1,
      "maxItems": 8
    },
    "evaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "material",
        "composition",
        "phase",
        "observable",
        "unit",
        "temperature",
        "referenceId",
        "protocol",
        "candidateSet"
      ],
      "properties": {
        "material": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000,
          "pattern": "\\S"
        },
        "composition": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000,
          "pattern": "\\S"
        },
        "phase": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000,
          "pattern": "\\S"
        },
        "observable": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000,
          "pattern": "\\S"
        },
        "unit": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000,
          "pattern": "\\S"
        },
        "temperature": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000,
              "pattern": "\\S"
            },
            {
              "type": "null"
            }
          ]
        },
        "referenceId": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000,
              "pattern": "\\S"
            },
            {
              "type": "null"
            }
          ]
        },
        "protocol": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000,
              "pattern": "\\S"
            },
            {
              "type": "null"
            }
          ]
        },
        "candidateSet": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000,
          "pattern": "\\S"
        }
      }
    },
    "arms": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "modelId",
          "artifactSha256",
          "intervention",
          "fitExposure",
          "referenceId"
        ],
        "properties": {
          "modelId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000,
            "pattern": "\\S"
          },
          "artifactSha256": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "intervention": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000,
            "pattern": "\\S"
          },
          "fitExposure": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000,
                "pattern": "\\S"
              },
              {
                "type": "null"
              }
            ]
          },
          "referenceId": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000,
                "pattern": "\\S"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      },
      "minItems": 2,
      "maxItems": 8
    },
    "unknowns": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2000,
        "pattern": "\\S"
      },
      "minItems": 0,
      "maxItems": 24
    },
    "excludedScope": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2000,
        "pattern": "\\S"
      },
      "minItems": 1,
      "maxItems": 24
    },
    "decisionRule": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000,
      "pattern": "\\S"
    },
    "falsifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000,
      "pattern": "\\S"
    },
    "stoppingRule": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000,
      "pattern": "\\S"
    }
  }
}
